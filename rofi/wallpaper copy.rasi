@import "~/.config/rofi/colors/active.rasi"
@import "~/.config/rofi/shared/fonts.rasi"

configuration {
    show-icons: true;
}

* {
    background-color:   @background;
    text-color:         @foreground;
    border-color:       @selected;
}

window {
    width:              1400px;
    height:             560px;
    border:             2px solid;
    border-radius:      16px;
    border-color:       @selected;
    background-color:   @background;
}

mainbox {
    spacing:            10px;
    padding:            20px;
    background-color:   transparent;
    children:           [ "inputbar", "message", "listview" ];
}

inputbar {
    spacing:            10px;
    padding:            12px 16px;
    border-radius:      12px;
    background-color:   @background-alt;
    text-color:         @foreground;
    children:           [ "prompt", "entry" ];
}

prompt, entry {
    background-color:   transparent;
    text-color:         @foreground;
}

prompt {
    text-color:         @selected;
}

entry {
    placeholder:        "Type to filter...";
    placeholder-color:  @selected;
}

message {
    padding:            8px 16px;
    border-radius:      10px;
    background-color:   @background-alt;
    text-color:         @foreground;
}

textbox {
    background-color:   transparent;
    text-color:         @foreground;
    horizontal-align:   0.5;
    font:               "Google Sans Display 10";
}

listview {
    columns:            8;
    lines:              1;
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    layout:             vertical;
    fixed-height:       true;
    fixed-columns:      true;
    spacing:            12px;
    border:             0px;
    background-color:   transparent;
}

element {
    orientation:        vertical;
    spacing:            0px;
    padding:            0px;
    border:             3px solid;
    border-radius:      12px;
    border-color:       transparent;
    background-color:   @background-alt;
    cursor:             pointer;
}

element normal.normal {
    border-color:       transparent;
    background-color:   @background-alt;
}

element selected.normal {
    border-color:       @selected;
    background-color:   @background-alt;
    text-color:         @selected;
}

element alternate.normal {
    border-color:       transparent;
    background-color:   @background-alt;
}

element-icon {
    size:               300px;
    border-radius:      10px 10px 0px 0px;
    background-color:   transparent;
    cursor:             inherit;
    expand:             true;
}

element-text {
    horizontal-align:   0.5;
    vertical-align:     0.5;
    padding:            8px 4px;
    font:               "Google Sans Display 10";
    text-color:         inherit;
    background-color:   transparent;
    cursor:             inherit;
    expand:             false;
}

error-message {
    padding:            15px;
    border:             2px solid;
    border-radius:      12px;
    border-color:       @selected;
    background-color:   @background;
    text-color:         @foreground;
}
